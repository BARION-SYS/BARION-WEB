# barion (web — sitio público) — copiar a .env (dev) / .env.production (prod)
#
# Los valores de aquí son EJEMPLOS: ningún dominio real vive en este archivo,
# que sí se versiona. Los dominios de cada entorno van en el `.env`, que no.

# Puerto en el que escucha Next. Es el mismo DENTRO del contenedor y en el host:
# el compose del padre mapea LANDING_PORT:6525 y `Dockerfile.dev` declara
# EXPOSE 6525. Sin esta variable `next dev` se va a 3000 y el contenedor arranca
# sano con el puerto publicado sin nadie detrás — el fallo más difícil de leer.
PORT=6525

# URL de la API vista desde el SERVIDOR de Next (no desde el navegador), con
# prefijo /api y versión /v1.
#
# SIN `NEXT_PUBLIC_`, y es lo importante: ese prefijo no describe la variable,
# ORDENA incrustarla en el JavaScript que descarga el navegador. El navegador no
# habla nunca con esta dirección — pide a este mismo sitio (`/api/planes`) y el
# servidor va a buscar el dato. Así no hay CORS, la URL no está en el bundle y
# la API se puede mover sin recompilar.
#
# Hace falta también en tiempo de BUILD: `/llms.txt` se prerrenderiza con los
# precios dentro.
#
# OJO al cambiar de lado: quien resuelve esta dirección es el proceso de Next.
# Corriendo en el host, `localhost` es la api del host. DENTRO del contenedor,
# `localhost` es el propio contenedor y no hay nadie escuchando: ahí la
# dirección es `http://api:2201/api/v1`, el nombre del servicio en el compose.
# Con un dominio público (el caso del entorno de demostración) da igual desde
# dónde se llame.
API_URL=http://localhost:2201/api/v1

# Dirección de la APLICACIÓN (repo BARION-FRONT). Entrar y registrarse son suyos:
# aquí solo se enlaza, con URL absoluta. Sin esta variable el build falla.
NEXT_PUBLIC_APP_URL=http://localhost:2203

# Dirección pública de ESTE sitio. Opcional en dev, IMPRESCINDIBLE en producción:
# de ella salen la imagen social, la canónica, el `@id` del JSON-LD, el sitemap y
# la referencia al mapa dentro del robots.txt. Sin ella el sitio se sirve entero
# pero sin nada de eso — mejor omitirlo que publicarlo apuntando a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:6525

# Orígenes permitidos en dev (proxy/HMR), separados por coma — solo servidor, no
# llega al cliente. Detrás de un proxy con dominio, poner ese dominio SIN esquema.
ALLOWED_DEV_ORIGINS=
